# Copy to .env.local (git-ignored) and fill in values.
# The web dashboard (apps/web-dashboard) loads this repository-root file via next.config.ts.

# -----------------------------------------------------------------------------
# Product catalog persistence (Phase 1 Ranking Intelligence)
# -----------------------------------------------------------------------------
# local (default): server JSON file at data/products-store.json (gitignored)
# supabase: reserved — apply database/migrations/001_ranking_foundation.sql first
# PRODUCTS_PERSISTENCE=local

# -----------------------------------------------------------------------------
# Supabase (Auth, Sessions & Saved Searches)
# -----------------------------------------------------------------------------
# Public Supabase project settings. These are safe for browser code.
NEXT_PUBLIC_SUPABASE_URL=https://fxwelcidbobizssrewip.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> "Publishable key" (starts with sb_publishable_).
# Never put a secret key (sb_secret_...) or the service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key

# Optional. Public origin used in sign-up confirmation emails (must also be listed under
# Supabase -> Authentication -> URL Configuration). Defaults to the request host.
# SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Keyword Research Providers (Server-side only — never prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# Google Search Console (own verified properties only). OAuth refresh token with webmasters.readonly.
# https://developers.google.com/webmaster-tools/v1/how-tos/authorizing
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
# URL-prefix (https://www.example.com/) or domain property (sc-domain:example.com)
# GSC_SITE_URL=

# Google Ads API (Keyword Planner volume, competition, bids). Needs Basic or Standard access.
# https://developers.google.com/google-ads/api/docs/start
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# 10-digit customer ID (dashes allowed or without dashes)
GOOGLE_ADS_CUSTOMER_ID=
# Only when access is through a manager (MCC) account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# YouTube Data API v3 (search.list default quota: 100 calls/day, videos.list: 1 unit).
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Amazon Creators API (replaced PA-API 5). Version 3.1 = NA, 3.2 = EU/India (default), 3.3 = FE.
# https://affiliate-program.amazon.in/creatorsapi/docs/en-us/introduction
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in

# Flipkart Affiliate API (affiliate ID and token).
# https://affiliate.flipkart.com/api-docs/
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# eBay Browse API (application keyset; client-credentials token).
# https://developer.ebay.com/api-docs/buy/browse/resources/item_summary/methods/search
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Etsy Open API v3 (keystring and shared secret).
# https://developers.etsy.com/documentation/
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# -----------------------------------------------------------------------------
# AI Keyword Expansion
# -----------------------------------------------------------------------------
# OpenAI API key (server-side only, never exposed to browser)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Documented Providers Planned For Future Phases (See docs/API_REQUIREMENTS_MATRIX.md)
# -----------------------------------------------------------------------------
# AMAZON_SP_API_CLIENT_ID=
# AMAZON_SP_API_CLIENT_SECRET=
# AMAZON_SP_API_REFRESH_TOKEN=
# FLIPKART_SELLER_CLIENT_ID=
# FLIPKART_SELLER_CLIENT_SECRET=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# KEYWORDTOOL_API_KEY=
# SEMRUSH_API_KEY=
# MICROSOFT_ADS_CLIENT_ID=
# MICROSOFT_ADS_CLIENT_SECRET=
# MICROSOFT_ADS_DEVELOPER_TOKEN=
# WALMART_CLIENT_ID=
# WALMART_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# X_BEARER_TOKEN=
# PINTEREST_ACCESS_TOKEN=
# META_APP_ID=
# META_APP_SECRET=
